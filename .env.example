# Server Configuration
PORT=5000
NODE_ENV=development
# Only expose internal error messages to clients when explicitly true (never in prod)
EXPOSE_ERRORS=false
# Max API requests per minute per IP
RATE_LIMIT_PER_MIN=120
# Comma-separated list of allowed origins in production (e.g. https://app.example.com)
ALLOWED_ORIGINS=

# API Keys (Get free keys from these services)
# Finnhub - https://finnhub.io (sign up for free tier)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Polygon.io - https://polygon.io (free tier available)
POLYGON_API_KEY=your_polygon_api_key_here

# Twelve Data - https://twelvedata.com (free tier - forex pairs)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# GoldAPI.io - https://goldapi.io (free tier - 100 reqs/month for XAU/USD)
GOLD_API_KEY=your_goldapi_key_here
